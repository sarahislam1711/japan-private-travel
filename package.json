{
  "name": "japan-private-travel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm guard:prod && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "guard": "tsx scripts/guard/index.ts",
    "guard:prod": "tsx scripts/guard/index.ts --prod",
    "test": "playwright test --project=e2e",
    "test:a11y": "playwright test --project=a11y",
    "shots": "playwright test --project=shots"
  },
  "dependencies": {
    "lenis": "^1.3.26",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.11.0"
}
